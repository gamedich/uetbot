# ==============================================================================
# ШАБЛОН КОНФИГУРАЦИИ МУП «УЛЬЯНОВСКЭЛЕКТРОТРАНС» (.env)
# Скопируйте этот файл в .env и укажите ваши реальные боевые значения:
#   copy .env.example .env     (в Windows)
#   cp .env.example .env       (в Linux)
# ==============================================================================

# 1. Режим работы системы:
#    TEST - режим отладки (все лимиты сняты, анкеты идут разработчику в ЛС)
#    PROD - боевой законный режим 152-ФЗ (строгие лимиты, анкеты строго кадровикам)
ENVIRONMENT=TEST

# 2. Telegram Bot API (Обязательно):
#    Токен бота, полученный у официального @BotFather
TG_BOT_TOKEN=your_telegram_bot_token_here

# 3. Права доступа (Обязательно):
#    Ваш личный Telegram ID (узнайте командой /id у бота)
SUPER_ADMIN_ID=
TECH_ADMIN_ID=

# 4. Кадровая группа Telegram (Рекомендуется для приёма резюме):
#    ID группы со знаком минус (например: -1001234567890) или привяжите через /set_group в группе
HR_GROUP_ID=0

# 5. Шлюз ВКонтакте (Опционально):
#    Ключ доступа сообщества VK с правами на сообщения и Long Poll
VK_GROUP_TOKEN=
VK_GROUP_ID=

# 6. Шлюз МАКС / VK Teams / MyTeam (Опционально):
#    Токен бота корпоративного мессенджера
MAX_BOT_TOKEN=
MAX_API_BASE=https://api.myteam.mail.ru/bot/v1

# 7. Контакты отдела кадров предприятия:
HR_PHONE=+
HR_ADDRESS=
HR_SCHEDULE=п

# 8. Задержка антифлуда между вопросами соискателей в секундах (по умолчанию 1200 = 20 мин):
COOLDOWN_SECONDS=1200

# 9. Служебные флаги:
MAINTENANCE_MODE=0
ANONYMIZE_LOGS=1
