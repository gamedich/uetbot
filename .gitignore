# ==============================================================================
# .gitignore — МУП «Ульяновскэлектротранс» UETBot
# Исключает секреты, ПДн, кэши, виртуальные окружения и генерируемые файлы.
# ==============================================================================

# --- Секреты и конфигурация ---
.env
.env.local
.env.*.local

# --- Python кэши ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Виртуальные окружения ---
venv/
env/
.venv/
.env/
ENV/

# --- Базы данных SQLite (152-ФЗ: персональные данные соискателей) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3

# --- Логи ---
logs/
*.log

# --- Резервные копии (генерируются автоматически, не для git) ---
backups/

# --- Сгенерированные кадровые документы (содержат ПДн) ---
docs/generated/
*.docx
*.xlsx
*.csv
*.pdf

# --- IDE и системные файлы ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Временные файлы ---
tmp/
temp/
