# ==============================================================================
# .gitignore — МУП «Ульяновскэлектротранс» UETBot
# ==============================================================================

# --- Секреты и конфигурация ---
.env
.env.*
*.env
*.pem
*.key

# --- Приватные утилиты и тестовые скрипты ---
private_*.py
templates/private_*.html
run_tests.py
test_scratch_*.py
test_auth_refactor.py
clean_*.py
fix_*.py
update_*.py
local_git.py
local_git*
scripts/local_admin_*
private/
audit_report.md
audit_*.md

# --- Персональные данные (152-ФЗ РФ) и дампы БД ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*
!data/.gitkeep
!data/vacancies.json
!data/notes.json
backups/
*.zip
*.docx
*.xlsx
*.csv
*.pdf
docs/generated/

# --- Логи и кэш ---
logs/
*.log
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Виртуальные окружения ---
venv/
env/
.venv/
.env/
ENV/

# --- Сборки документации и артефакты ---
site/
.cache/

# --- IDE и системные файлы ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tmp/
temp/
path/to/web-switcher/
switch_script.sh

# --- Локальные настройки окружения ---
*.local
*.local.*
.local/
