# ==============================================================================
# ШАБЛОН КОНФИГУРАЦИИ МУП «УЛЬЯНОВСКЭЛЕКТРОТРАНС» (.env)
# Соответствие методологии 12-Factor App (Config in Environment)
#
# Скопируйте этот файл в .env и укажите ваши значения:
#   cp .env.example .env       (Linux/macOS)
#   copy .env.example .env     (Windows)
#
# ВНИМАНИЕ: файл .env содержит секреты и исключён из Git (.gitignore)!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. СРЕДА ОКРУЖЕНИЯ (ENVIRONMENT)
# ------------------------------------------------------------------------------
# Допустимые значения:
#   DEV   (или TEST) — локальная разработка и отладка (изолированная база, подробные логи)
#   PROD             — боевой контур (строгие проверки 152-ФЗ, боевая база, закрытый контур)
ENVIRONMENT=DEV

# Версия сервиса
BOT_VERSION=2.0.0

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT API (ОБЯЗАТЕЛЬНО)
# ------------------------------------------------------------------------------
# Токен бота, полученный у @BotFather в Telegram.
# Поддерживаются имена BOT_TOKEN и TG_BOT_TOKEN.
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Юзернейм бота (без @)
BOT_USERNAME=UetFeedback_bot

# ------------------------------------------------------------------------------
# 3. БАЗА ДАННЫХ SQLITE (ИЗОЛЯЦИЯ ДАННЫХ)
# ------------------------------------------------------------------------------
# Путь к файлу базы данных SQLite.
# Всегда сохраняется внутри директории data/ и никогда не коммитится в Git!
# Примеры:
#   Для PROD: data/prod.db (или data/resumes.db)
#   Для DEV:  data/dev.db  (или data/resumes_test.db)
DB_PATH=data/dev.db

# ------------------------------------------------------------------------------
# 4. АДМИНИСТРАТИВНЫЙ ДОСТУП И БЕЗОПАСНОСТЬ
# ------------------------------------------------------------------------------
# Цифровой Telegram ID главного администратора (SuperAdmin / Владелец).
# Получить свой ID можно через бота @userinfobot или командой /id в боте.
SUPER_ADMIN_ID=123456789

# Telegram ID технического администратора (опционально)
TECH_ADMIN_ID=123456789

# Пароли веб-панели (при первом входе автоматически хешируются через scrypt)
SUPER_ADMIN_PASSWORD=change_me_super_secret_password_2026
HR_ADMIN_PASSWORD=change_me_hr_password_2026

# ID группы кадровой службы в Telegram для пересылки анкет (начинается с -100)
HR_GROUP_ID=0

# ------------------------------------------------------------------------------
# 5. СЕТЬ И ВЕБ-ПАНЕЛЬ УПРАВЛЕНИЯ
# ------------------------------------------------------------------------------
# Внешний URL панели управления и Telegram Mini App
WEB_APP_URL=http://127.0.0.1:8082
WEB_APP_HOST=127.0.0.1
WEB_APP_PORT=8082

# HTTP/SOCKS5 прокси при необходимости обхода сетевых ограничений
# PROXY_URL=http://user:password@proxy.example.com:8080

# ------------------------------------------------------------------------------
# 6. ВНЕШНИЕ ШЛЮЗЫ (ОПЦИОНАЛЬНО)
# ------------------------------------------------------------------------------
# ВКонтакте: ключ доступа сообщества и ID группы
VK_GROUP_TOKEN=
VK_GROUP_ID=

# Корпоративный мессенджер МАКС (Mail.ru for Business / VK Teams)
MAX_BOT_TOKEN=
MAX_API_BASE=https://api.myteam.mail.ru/bot/v1

# ------------------------------------------------------------------------------
# 7. СИСТЕМНЫЕ ПАРАМЕТРЫ И 152-ФЗ РФ
# ------------------------------------------------------------------------------
# Антифлуд между вопросами (в секундах)
COOLDOWN_SECONDS=1200

# Режим техобслуживания (1 — включен, 0 — выключен)
MAINTENANCE_MODE=0

# Маскирование персональных данных в логах (требование 152-ФЗ)
ANONYMIZE_LOGS=1
