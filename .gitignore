# ==============================================================================
# .gitignore — МУП «Ульяновскэлектротранс» UETBot
# ЖЁСТКАЯ ИЗОЛЯЦИЯ PRIVATE VS PUBLIC
# ==============================================================================

# --- Секреты и конфигурация ---
.env
.env.*
*.pem
*.key

# --- Приватные модули владельца и инженерии ---
private_admin.py
private_*.py
handlers/tech.py
tech.py
run_tests.py
tests/
test_*.py
clean_*.py
fix_*.py
update_*.py
local_git.py
local_git*
scripts/local_admin_*
private/

# --- Персональные данные (152-ФЗ РФ) и дампы БД ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
backups/
*.zip
*.docx
*.xlsx
*.csv
*.pdf
docs/generated/

# --- Логи и кэш ---
logs/
*.log
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Виртуальные окружения ---
venv/
env/
.venv/
.env/
ENV/

# --- Сборки документации и артефакты ---
site/
.cache/

# --- IDE и системные файлы ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tmp/
temp/
path/to/web-switcher/
switch_script.sh

# --- Antigravity IDE / AI ассистент ---
.antigravity*
.agents/
templates/antigravity_*
*.antigravity*
