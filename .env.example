# ==============================================================================
# ШАБЛОН КОНФИГУРАЦИИ МУП «УЛЬЯНОВСКЭЛЕКТРОТРАНС» (.env)
#
# Скопируйте этот файл в .env и укажите ваши реальные боевые значения:
#   cp .env.example .env       (Linux/macOS)
#   copy .env.example .env     (Windows)
#
# ВНИМАНИЕ: файл .env содержит секреты и не должен попасть в git (включён в .gitignore)!
# ==============================================================================


# ==============================================================================
# 1. СРЕДА ВЫПОЛНЕНИЯ
# ==============================================================================

# Режим работы системы:
#   TEST — режим отладки: все лимиты сняты, анкеты дублируются разработчику в ЛС
#   PROD — боевой режим 152-ФЗ: строгие лимиты, анкеты строго кадровикам
ENVIRONMENT=TEST

# Версия сервиса (отображается в стартовом сообщении SuperAdmin)
BOT_VERSION=1.6.0


# ==============================================================================
# 2. TELEGRAM BOT API (ОБЯЗАТЕЛЬНО)
# ==============================================================================

# Токен бота, полученный у @BotFather в Telegram
# Формат: 123456789:AABBccDDeeffGGhhIIjjKKllMMnnOOppQQ
TG_BOT_TOKEN=your_telegram_bot_token_here


# ==============================================================================
# 3. ПРАВА ДОСТУПА (ОБЯЗАТЕЛЬНО)
# ==============================================================================

# Telegram ID владельца системы — получить командой /id в боте
# SuperAdmin имеет полный доступ ко всем функциям
SUPER_ADMIN_ID=

# Telegram ID технического инженера (опционально, если отличается от SuperAdmin)
TECH_ADMIN_ID=


# ==============================================================================
# 4. КАДРОВАЯ ГРУППА TELEGRAM
# ==============================================================================

# ID группы/суперчата кадровой службы (со знаком минус, например: -1001234567890)
# Все новые анкеты соискателей автоматически поступают в эту группу
# Можно привязать через команду /set_group прямо из группы
HR_GROUP_ID=0


# ==============================================================================
# 5. ШЛЮЗ ВКОНТАКТЕ (ОПЦИОНАЛЬНО)
# ==============================================================================

# Ключ доступа сообщества VK с правами: Сообщения + Управление + Long Poll API
VK_GROUP_TOKEN=

# Числовой ID сообщества VK (без знака @, только цифры)
VK_GROUP_ID=


# ==============================================================================
# 6. ШЛЮЗ МАКС / VK Teams / MyTeam (ОПЦИОНАЛЬНО)
# ==============================================================================

# Токен бота корпоративного мессенджера МАКС (Mail.ru for Business)
MAX_BOT_TOKEN=

# Базовый URL API мессенджера (по умолчанию — МАКС)
MAX_API_BASE=https://api.myteam.mail.ru/bot/v1


# ==============================================================================
# 7. КОНТАКТЫ ОТДЕЛА КАДРОВ ПРЕДПРИЯТИЯ
# ==============================================================================

# Отображаются соискателям в команде /contacts и в тексте FAQ
HR_PHONE=+7 (8422) 58-46-60
HR_ADDRESS=г. Ульяновск, ул. Гончарова, 2
HR_SCHEDULE=пн-пт 08:00–17:00 (перерыв 12:00–13:00)


# ==============================================================================
# 8. ПУТИ К ДАННЫМ (ОПЦИОНАЛЬНО — по умолчанию: папка проекта)
# ==============================================================================

# Абсолютный или относительный путь к боевой базе данных SQLite
# По умолчанию: <корень_проекта>/resumes.db
# DB_PATH=/var/lib/uetbot/resumes.db

# Файл лога бота
# По умолчанию: <корень_проекта>/logs/bot.log
# LOG_FILE=/var/log/uetbot/bot.log


# ==============================================================================
# 9. ВЕБЛАППЛИКАЦИЯ / TELEGRAM MINI APP (ОПЦИОНАЛЬНО)
# ==============================================================================

# Внешний URL веб-панели (если развернута)
# WEB_APP_URL=https://uet.example.ru/app
WEB_APP_HOST=0.0.0.0
WEB_APP_PORT=8080


# ==============================================================================
# 10. СИСТЕМНЫЕ ФЛАГИ
# ==============================================================================

# Антифлуд: минимальный интервал между повторными обращениями соискателя (в секундах)
# По умолчанию: 1200 (20 минут)
COOLDOWN_SECONDS=1200

# Режим технического обслуживания: при значении 1 бот возвращает заглушку всем пользователям
MAINTENANCE_MODE=0

# Анонимизация логов: при значении 1 телефоны и Telegram ID маскируются в файле лога
# Обязательно включить в PROD (требование ст. 19 152-ФЗ)
ANONYMIZE_LOGS=1

# Разрешить тестовые анкеты в боевом режиме PROD (только для отладки, не включать в продакшне!)
ALLOW_TEST_SUBMISSIONS_IN_PROD=0
