# --- Секреты и конфигурация ---
.env
.env.*
!.env.example
*.pem
*.key
DEV_PASSWORDS.md

# --- Приватные модули владельца и инженерии ---
private_admin.py
private_ai_bridge.py
private_*.py
web/private_ai.html
templates/private_*.html
# tests/ (включено для автотестов CI/CD)
run_tests.py
test_scratch_*.py
test_auth_refactor.py
clean_*.py
fix_*.py
update_*.py
local_git.py
local_git*
scripts/local_admin_*
private/
audit_report.md
audit_*.md

# --- Персональные данные (152-ФЗ РФ) и дампы БД ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*
!data/.gitkeep
!data/vacancies.json
!data/notes.json
backups/
*.zip
*.docx
*.xlsx
*.csv
*.pdf
docs/generated/

# --- Логи и кэш ---
logs/
*.log
__pycache__/
*.py[cod]
*$py.class
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Виртуальные окружения ---
venv/
env/
.venv/
.env/
ENV/

# --- Сборки документации и артефакты ---
site/
.cache/

# --- IDE и системные файлы ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tmp/
temp/
path/to/web-switcher/
switch_script.sh

# --- Antigravity IDE / Cursor / AI ассистент ---
.antigravity*
.agents/
templates/antigravity_*
*.antigravity*
.cursorrules
.cursor/
*MANUAL*.md
*manual*.md
SERVER_MANUAL.md
regulations.md
